# Required for Docker Compose
POSTGRES_DB=rosterops
POSTGRES_USER=rosterops
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Required in production: protects write endpoints
API_ACCESS_KEY=replace-with-a-long-random-api-key
APP_LOGIN_PASSWORD=replace-with-a-long-random-demo-login-password
APP_ENV=production
SEED_DEMO_DATA=true

# Optional AI agent provider (the app works without it)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Ports
API_PORT=8000
FRONTEND_PORT=8501
CORS_ORIGINS=http://localhost:8501
